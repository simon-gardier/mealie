FROM ghcr.io/astral-sh/uv:0.12.23 AS uv
FROM python:3.12-slim-bookworm
COPY --from=uv /uv /uvx /usr/local/bin/
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libldap2-dev libsasl2-dev libssl-dev git && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
ENV UV_FROZEN=1 UV_PROJECT_ENVIRONMENT=/opt/mealie-venv PRODUCTION=false API_PORT=9000 API_DOCS=true BASE_URL=http://localhost:3000 LANG=fr-FR DEFAULT_GROUP=Home DEFAULT_HOUSEHOLD=Family
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --extra pgsql --group dev --no-install-project
CMD ["uv", "run", "python", "mealie/app.py"]
